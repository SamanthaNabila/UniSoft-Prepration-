DATABASE_URL=postgresql://user:password@localhost:5432/unidesk

# Required. The app refuses to start without this. Must be at least 32 characters
# and must not be "changeme" or "dev-secret-key-change-me". Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
